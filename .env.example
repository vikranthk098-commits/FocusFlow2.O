# FocusFlow Client Environment Variables
# Provide your Supabase project URL and anon public key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key-here

# Backend API URL (defaults to http://localhost:5000 in development)
VITE_API_URL=http://localhost:5000
